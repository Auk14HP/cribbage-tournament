{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"vite.config.ts",
		"pagesBase.ts",
		"playwright.config.ts",
		"playwright.screens.config.ts",
		"e2e",
		"screens"
	]
}
